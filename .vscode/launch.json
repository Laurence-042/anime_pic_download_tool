{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "hydrus_tagger: dry-run",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/hydrus_tagger.py",
            "args": ["${input:targetDirectory}", "--dry-run"],
            "console": "integratedTerminal"
        },
        {
            "name": "hydrus_tagger: process",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/hydrus_tagger.py",
            "args": ["${input:targetDirectory}"],
            "console": "integratedTerminal"
        },
        {
            "name": "hydrus_tagger: skip existing",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/hydrus_tagger.py",
            "args": ["${input:targetDirectory}", "--skip-existing"],
            "console": "integratedTerminal"
        },
        {
            "name": "tag_analyzer",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tag_analyzer.py",
            "args": ["${input:targetDirectory}", "--exclude-common", "10", "--min-items", "3"],
            "console": "integratedTerminal"
        },
        {
            "name": "tag_analyzer: combinations only",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tag_analyzer.py",
            "args": ["${input:targetDirectory}", "--min-items", "2"],
            "console": "integratedTerminal"
        },
        {
            "name": "tag_analyzer: export json",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tag_analyzer.py",
            "args": ["${input:targetDirectory}", "-o", "${workspaceFolder}/tag_analysis.json"],
            "console": "integratedTerminal"
        },
        {
            "name": "compare_taggers: single file",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compare_taggers.py",
            "args": ["${input:targetFile}", "--tagger1", "${input:tagger1}", "--tagger2", "${input:tagger2}", "--threshold", "0.35"],
            "console": "integratedTerminal"
        },
        {
            "name": "compare_taggers: WD14 vs Camie V2",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compare_taggers.py",
            "args": ["${input:targetFile}", "--tagger1", "wd14", "--tagger2", "camie_v2", "--show-common"],
            "console": "integratedTerminal"
        },
        {
            "name": "compare_taggers: WD14 vs Camie",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compare_taggers.py",
            "args": ["${input:targetFile}", "--tagger1", "wd14", "--tagger2", "camie", "--show-common"],
            "console": "integratedTerminal"
        },
        {
            "name": "compare_taggers: WD14 vs MLDanbooru",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compare_taggers.py",
            "args": ["${input:targetFile}", "--tagger1", "wd14", "--tagger2", "mldanbooru", "--threshold", "0.4"],
            "console": "integratedTerminal"
        },
        {
            "name": "compare_taggers: directory batch",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compare_taggers.py",
            "args": ["${input:targetDirectory}", "--recursive", "--tagger1", "${input:tagger1}", "--tagger2", "${input:tagger2}"],
            "console": "integratedTerminal"
        },
        {
            "name": "compare_taggers: export comparison",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compare_taggers.py",
            "args": ["${input:targetFile}", "--tagger1", "${input:tagger1}", "--tagger2", "${input:tagger2}", "--threshold", "${input:threshold}", "--export", "${workspaceFolder}/comparison.json"],
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "targetDirectory",
            "type": "promptString",
            "description": "Directory to scan for image files",
            "default": "./download"
        },
        {
            "id": "targetFile",
            "type": "promptString",
            "description": "Image file to process",
            "default": "./download/pixiv_137957281_p0.jpg"
        },
        {
            "id": "tagger1",
            "type": "pickString",
            "description": "First tagger",
            "options": ["wd14", "mldanbooru", "camie", "camie_v2"],
            "default": "wd14"
        },
        {
            "id": "tagger2",
            "type": "pickString",
            "description": "Second tagger",
            "options": ["wd14", "mldanbooru", "camie", "camie_v2"],
            "default": "camie_v2"
        },
        {
            "id": "threshold",
            "type": "promptString",
            "description": "Confidence threshold (0.0 - 1.0)",
            "default": "0.35"
        }
    ]
}